# Copy to ~/.config/dyo-planner/backup.env on the server, fill in, chmod 600.
# Never commit the filled-in file.

# Database (same connection as ~/db-backup.sh)
PG_HOST=aws-0-eu-west-1.pooler.supabase.com
PG_PORT=5432
PG_USER=postgres.vljrrwbsfmafmfzhvuip
PG_DB=postgres
PGPASSFILE=/home/fahad/.config/dyo-planner/pgpass

# Supabase Storage (service-role key: same value as in /opt/dashboard-dyo-app/.env)
SUPABASE_URL=https://vljrrwbsfmafmfzhvuip.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# S3 (restricted IAM user: Put/Get/List only, no Delete)
S3_BUCKET=
S3_PREFIX=planner
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Slack incoming webhook for ✅ / ❌ / ⚠️ messages
SLACK_BACKUP_WEBHOOK_URL=

# Local copy of the latest backup, and the log
LOCAL_DIR=/home/fahad/planner-s3-backups

# Binaries (cron has a minimal PATH)
NODE_BIN=/home/fahad/.nvm/versions/node/v22.23.2/bin/node
AWS_BIN=/home/fahad/.local/bin/aws
